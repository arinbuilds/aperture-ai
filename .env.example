# Local Node server
PORT=4173

# Video analysis (backend only; never add this key to frontend JavaScript)
GEMINI_API_KEY=replace_with_your_gemini_api_key
# Optional. Defaults to the server's configured vision model.
GEMINI_MODEL=gemini-3.8-flash

# Supabase Auth (use the project's public anon/publishable key only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_public_anon_key
